{
  "version": "0.2",
  "language": "en",
  "words": [
    "autofocus",
    "cupertino",
    "deutsch",
    "français",
    "fvmrc",
    "malus",
    "ondenufe",
    "pubspec",
    "schlaeger",
    "sublist",
